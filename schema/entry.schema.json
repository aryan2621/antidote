{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/aryan2621/antidote/schema/entry.schema.json",
  "title": "Antidote entry (OSV extension)",
  "oneOf": [{ "$ref": "#/$defs/artifact" }, { "$ref": "#/$defs/incident" }],
  "$defs": {
    "date": { "type": "string", "format": "date-time" },
    "strings": { "type": "array", "items": { "type": "string" } },
    "artifact": {
      "type": "object",
      "required": ["schema_version", "id", "modified", "published", "summary", "affected", "database_specific"],
      "properties": {
        "schema_version": { "type": "string" },
        "id": { "type": "string", "pattern": "^AGT-\\d{4}-\\d{4,}$" },
        "modified": { "$ref": "#/$defs/date" },
        "withdrawn": { "$ref": "#/$defs/date" },
        "published": { "$ref": "#/$defs/date" },
        "aliases": { "$ref": "#/$defs/strings" },
        "summary": { "type": "string", "maxLength": 200 },
        "details": { "type": "string" },
        "references": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["type", "url"],
            "properties": { "type": { "type": "string" }, "url": { "type": "string" } }
          }
        },
        "affected": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "required": ["package"],
            "properties": {
              "package": {
                "type": "object",
                "required": ["ecosystem", "name"],
                "properties": {
                  "ecosystem": {
                    "enum": ["clawhub", "mcp-registry", "smithery", "claude-skill", "cursor-rule", "npm", "PyPI", "GitHub"]
                  },
                  "name": { "type": "string" }
                }
              },
              "versions": { "$ref": "#/$defs/strings" },
              "ranges": { "type": "array" }
            }
          }
        },
        "database_specific": {
          "type": "object",
          "required": ["artifact_type", "classification", "verification"],
          "properties": {
            "artifact_type": { "enum": ["skill", "mcp_server", "tool_description", "prompt", "package", "model_file"] },
            "classification": { "enum": ["malicious", "vulnerable", "suspicious"] },
            "techniques": { "$ref": "#/$defs/strings" },
            "agents_affected": { "$ref": "#/$defs/strings" },
            "indicators": {
              "type": "object",
              "properties": {
                "sha256": { "type": "array", "items": { "type": "string", "pattern": "^[0-9a-f]{64}$" } },
                "domains": { "$ref": "#/$defs/strings" },
                "patterns": { "$ref": "#/$defs/strings" }
              },
              "additionalProperties": false
            },
            "sample": {
              "type": "object",
              "properties": {
                "available": { "type": "boolean" },
                "defanged": { "type": "boolean" },
                "access": { "enum": ["public", "gated", "none"] }
              }
            },
            "verification": { "enum": ["verified", "reported", "disputed"] },
            "severity": { "enum": ["low", "medium", "high", "critical"] },
            "reporter": { "type": "string" },
            "detections": { "$ref": "#/$defs/strings" }
          }
        }
      }
    },
    "incident": {
      "type": "object",
      "required": ["id", "kind", "summary", "date", "trigger", "impact", "references"],
      "properties": {
        "schema_version": { "type": "string" },
        "id": { "type": "string", "pattern": "^AGT-INC-\\d{4}-\\d{4,}$" },
        "kind": { "const": "incident" },
        "summary": { "type": "string", "maxLength": 200 },
        "agent": { "type": "string" },
        "model": { "type": "string" },
        "date": { "type": "string" },
        "trigger": { "enum": ["prompt injection", "misconfiguration", "model error", "malicious tool"] },
        "impact": { "enum": ["data loss", "data leak", "sandbox escape", "cost blowout", "code execution"] },
        "root_cause": { "type": "string" },
        "would_have_prevented": { "$ref": "#/$defs/strings" },
        "references": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "related_entries": { "$ref": "#/$defs/strings" }
      }
    }
  }
}
