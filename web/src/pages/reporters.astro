---
import Base from '../layouts/Base.astro';
import { entries } from '../lib/entries';

// Accepted (non-withdrawn) entries per reporter, most first.
const counts = new Map<string, { total: number; verified: number }>();
for (const e of entries) {
  const db = e.database_specific ?? {};
  if (e.withdrawn || !db.reporter) continue;
  const c = counts.get(db.reporter) ?? { total: 0, verified: 0 };
  c.total++;
  if (db.verification === 'verified') c.verified++;
  counts.set(db.reporter, c);
}
const rows = [...counts].sort((a, b) => b[1].total - a[1].total || a[0].localeCompare(b[0]));
---
<Base title="Reporters: Antidote" description="Who reported the entries in the Antidote database." current="reporters">
  <h1>Reporters</h1>
  <p class="column lede">Entries per reporter, not counting withdrawn ones. Reporters are credited by the <code>reporter</code> field of each entry.</p>
  <table>
    <thead><tr><th scope="col">Rank</th><th scope="col">Reporter</th><th scope="col" class="num">Entries</th><th scope="col" class="num">Verified</th></tr></thead>
    <tbody>
      {rows.map(([name, c], i) => <tr><td class="mono">{i + 1}</td><th scope="row">{name}</th><td class="num mono">{c.total}</td><td class="num mono">{c.verified}</td></tr>)}
    </tbody>
  </table>
</Base>

<style>
  h1 { max-width: none; }
  .lede { margin: 1.1rem 0 2rem; font-size: 1.2rem; color: var(--ink-2); }
  table { width: 100%; max-width: 52rem; border-collapse: collapse; border: var(--bw) solid var(--ink); }
  th, td { text-align: left; padding: 0.65rem 0.9rem; border-bottom: 1px solid var(--rule-strong); }
  thead th { background: var(--ink); color: var(--paper); font: 700 1.05rem/1.2 var(--sc); letter-spacing: 0.1em; text-transform: uppercase; }
  tbody th { font-weight: 600; }
  .num { text-align: right; }
</style>
