---
import Base from '../layouts/Base.astro';
import Signal from '../components/Signal.astro';
import Bars from '../components/Bars.astro';
import Trend from '../components/Trend.astro';
import { entries, classification, artifactType } from '../lib/entries';

const live = entries.filter((e) => !e.withdrawn);
const pct = (n: number) => (live.length ? Math.round((100 * n) / live.length) : 0);
const verified = live.filter((e) => e.database_specific?.verification === 'verified').length;

const tally = (keys: string[]) => {
  const m = new Map<string, number>();
  for (const k of keys) m.set(k, (m.get(k) ?? 0) + 1);
  return [...m] as [string, number][];
};
const byClass = tally(live.map(classification)).sort((a, b) => b[1] - a[1]);
const byKind = tally(live.map((e) => artifactType(e).replaceAll('_', ' '))).sort((a, b) => b[1] - a[1]);
const byEco = tally(live.flatMap((e) => [...new Set((e.affected ?? []).map((a: any) => a.package.ecosystem as string))])).sort((a, b) => b[1] - a[1]);
const byMonth = tally(live.map((e) => (e.published ?? e.date ?? '').slice(0, 7)).filter(Boolean)).sort((a, b) => a[0].localeCompare(b[0]));
const trendSeries = [
  { key: 'malicious', label: 'Danger', color: 'var(--malicious)' },
  { key: 'vulnerable', label: 'Warning', color: 'var(--vulnerable)', dash: '6 3' },
  { key: 'suspicious', label: 'Caution', color: 'var(--suspicious)', dash: '2 3' },
  { key: 'incident', label: 'Notice', color: 'var(--incident)', dash: '8 3 2 3' },
];
// cumulative per month, per verdict; entries without a date are left out
const trendRows = (() => {
  const run: Record<string, number> = {};
  return byMonth.map(([month]) => {
    for (const e of live.filter((e) => (e.published ?? e.date ?? '').slice(0, 7) === month)) run[classification(e)] = (run[classification(e)] ?? 0) + 1;
    return { month, counts: { ...run } };
  });
})();
const byTechnique = tally(live.flatMap((e) => e.database_specific?.techniques ?? [])).sort((a, b) => b[1] - a[1]);
---
<Base title="Stats: Antidote" description="How many entries the Antidote database holds, how many are verified, and what kinds." current="stats">
  <h1>Stats</h1>
  <p class="lede column">
    {live.length} live entries, {entries.length - live.length} withdrawn. {verified} are verified ({pct(verified)}%); the rest are reported and waiting for a second look. Rebuilt on every corpus change.
  </p>

  <h2>By verdict</h2>
  <ul class="verdicts">
    {byClass.map(([k, n]) => <li class={k}><span class="n">{n}</span><Signal kind={k} /><span class="muted">{pct(n)}% of live entries</span></li>)}
  </ul>

  <h2>By kind of artifact</h2>
  <Bars rows={byKind} caption="Live entries by artifact type" />

  <h2>By ecosystem</h2>
  <Bars rows={byEco} caption="Live entries by ecosystem" />

  <h2>Trend</h2>
  <Trend rows={trendRows} series={trendSeries} caption="Cumulative live entries by verdict, by month" />

  <h2>Published per month</h2>
  <Bars rows={byMonth} mono caption="Live entries published per month" />

  {byTechnique.length > 0 && (
    <>
      <h2>Techniques</h2>
      <Bars rows={byTechnique} mono caption="Live entries by technique tag" />
    </>
  )}
</Base>

<style>
  h1 { max-width: none; }
  .lede { margin: 1.1rem 0 0; font-size: 1.25rem; color: var(--ink-2); }
  .verdicts { list-style: none; padding: 0; margin: 0; display: grid; grid-template-columns: repeat(auto-fit, minmax(14rem, 1fr)); gap: 12px; }
  .verdicts li { display: grid; gap: 0.4rem; justify-items: start; padding: 0.9rem 1rem; border: var(--bw) solid var(--ink); background: var(--plate); }
  .verdicts .n { font: 800 3.4rem/0.9 var(--sc); }
</style>
