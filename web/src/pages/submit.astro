---
import Base from '../layouts/Base.astro';
import { REPO } from '../lib/entries';
const ecosystems = ['npm', 'PyPI', 'clawhub', 'mcp-registry', 'smithery', 'claude-skill', 'cursor-rule', 'GitHub'];
---
<Base title="Submit a report: Antidote" description="Report a malicious or vulnerable AI agent skill, MCP server or prompt." current="submit">
  <h1>Submit a report</h1>
  <p class="column lede">
    This form only builds a prefilled GitHub issue. Nothing is sent until you submit that issue on GitHub. For agent incidents with no malicious file, run <code>antidote incident new</code> instead.
  </p>

  <form id="f" class="column">
    <label>Ecosystem
      <select name="ecosystem" required>{ecosystems.map((e) => <option>{e}</option>)}</select>
    </label>
    <label>Name
      <input name="name" required placeholder="@scope/package, owner/skill or owner/repo" autocomplete="off" spellcheck="false" />
    </label>
    <label>Affected versions
      <input name="versions" placeholder="1.0.16, or all" autocomplete="off" />
    </label>
    <label>Verdict
      <select name="classification" required>
        <option value="malicious">Malicious: built to do harm</option>
        <option value="vulnerable">Vulnerable: an honest bug</option>
        <option value="suspicious">Suspicious: looks wrong, not confirmed</option>
      </select>
    </label>
    <label>Evidence
      <span class="hint">Links to public reports, advisories, CVE or GHSA ids, sha256 of the files.</span>
      <textarea name="evidence" rows="3" required></textarea>
    </label>
    <label>What it does
      <span class="hint">In plain words, as you would tell a colleague.</span>
      <textarea name="behavior" rows="4" required></textarea>
    </label>
    <aside class="note">
      <p>Don't paste live payloads, and defang domains (<code>evil[.]example</code>).</p>
      <p>For <em>vulnerable</em> items, tell the author first and allow 30 to 90 days before the entry goes public.</p>
    </aside>
    <button type="submit" class="btn">Open prefilled GitHub issue</button>
  </form>

  <script define:vars={{ repo: REPO }}>
    const form = document.getElementById('f');
    form.addEventListener('submit', (ev) => {
      ev.preventDefault();
      const v = (k) => String(new FormData(form).get(k) ?? '').trim();
      const body = [
        'Submitted from the Antidote website.',
        '',
        `- **What:** ${v('ecosystem')}:${v('name')}, versions: ${v('versions') || 'unknown'}`,
        `- **Classification:** ${v('classification')}`,
        `- **Evidence:** ${v('evidence')}`,
        `- **Behavior:** ${v('behavior')}`,
      ].join('\n');
      const url = `https://github.com/${repo}/issues/new?title=${encodeURIComponent(`Report: ${v('ecosystem')}:${v('name')}`)}&body=${encodeURIComponent(body)}`;
      window.open(url, '_blank', 'noopener');
    });
  </script>
</Base>

<style>
  h1 { max-width: none; }
  .lede { margin: 1.1rem 0 2rem; font-size: 1.2rem; color: var(--ink-2); }
  form { display: grid; gap: 1.4rem; }
  label { display: grid; gap: 0.35rem; font: 700 1.1rem/1.2 var(--sc); letter-spacing: 0.08em; text-transform: uppercase; }
  .hint { font: 400 1rem/1.4 var(--sans); letter-spacing: 0; text-transform: none; color: var(--ink-2); }
  input, select, textarea {
    font: 400 1.1rem/1.4 var(--sans); letter-spacing: 0; text-transform: none; padding: 0.65rem 0.8rem; min-height: 48px; width: 100%;
    color: var(--ink); background: var(--plate); border: var(--bw) solid var(--ink); border-radius: var(--r);
  }
  input[name='name'], input[name='versions'] { font-family: var(--mono); font-size: 1rem; }
  textarea { resize: vertical; }
  input:focus-visible, select:focus-visible, textarea:focus-visible { outline: 4px solid var(--caution); outline-offset: 0; }
  /* CAUTION notice: the one place a yellow band is earned on this page */
  .note { border: var(--bw) solid var(--ink); background: var(--plate); }
  .note::before { content: 'Caution'; display: block; padding: 0.3rem 0.8rem; background: var(--caution); color: #0b0b0c; font: 800 1.2rem/1 var(--sc); letter-spacing: 0.1em; text-transform: uppercase; }
  .note p { margin: 0; padding: 0.6rem 0.8rem 0; }
  .note p:last-child { padding-bottom: 0.8rem; }
  button { justify-self: start; }
</style>
