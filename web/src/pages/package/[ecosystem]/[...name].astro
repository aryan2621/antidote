---
import Base from '../../../layouts/Base.astro';
import Signal from '../../../components/Signal.astro';
import CodeBlock from '../../../components/CodeBlock.astro';
import { packages, classification, entryHref, versionText, badgeMarkdown, lookalikeOf, href } from '../../../lib/entries';

export function getStaticPaths() {
  return [...packages.values()].map((p) => ({ params: { ecosystem: p.ecosystem, name: p.name }, props: { p } }));
}
const { p } = Astro.props;
const label = `${p.ecosystem}:${p.name}`;
const badge = badgeMarkdown(p.ecosystem, p.name);
const live = p.entries.filter((e: any) => !e.withdrawn);
const verdict = live.some((e: any) => classification(e) === 'malicious') ? 'malicious'
  : live.some((e: any) => classification(e) === 'vulnerable') ? 'vulnerable'
  : live.length ? 'suspicious' : 'withdrawn';
const headline: Record<string, string> = {
  malicious: 'Reported as malicious',
  vulnerable: 'Has known vulnerabilities',
  suspicious: 'Flagged as suspicious',
  withdrawn: 'Earlier reports were withdrawn',
};
const real = lookalikeOf(p.ecosystem, p.name);
const n = p.entries.length;
---
<Base title={`Is ${p.name} safe? Antidote`} description={`${n} Antidote entr${n === 1 ? 'y' : 'ies'} for ${label}`} current="database">
  <nav class="crumb" aria-label="Breadcrumb"><a href={href('/')}>Database</a> <span aria-hidden="true">/</span> <span class="mono">{label}</span></nav>

  <header class={`vplate ${verdict}`}>
    <div class="vband">
      <Signal kind={verdict} />
      <p class="facts"><span>{headline[verdict]}</span><span>{n} entr{n === 1 ? 'y' : 'ies'}</span><span>{p.ecosystem}</span></p>
    </div>
    <div class="vbody">
      <h1><code>{p.name}</code></h1>
      <p class="column lede">
        Check the affected versions against yours, or run{' '}
        <code>antidote check {p.ecosystem.toLowerCase()}:{p.name}@&lt;version&gt;</code>.
        Absence from the database is never a safety verdict.
      </p>
      {real && <p class="column imitates">The name is close to the popular package <code>{real}</code>. Make sure you meant this one.</p>}
    </div>
  </header>

  <h2>Entries</h2>
  <ol class="rows">
    {p.entries.map((e: any) => (
      <li class="row">
        <a class="tab" href={entryHref(e.id)} aria-label={`${e.id}, ${classification(e)}`}><Signal kind={classification(e)} /></a>
        <div class="body">
          <p class="meta mono"><a href={entryHref(e.id)}>{e.id}</a></p>
          <h3><a href={entryHref(e.id)}>{e.summary}</a></h3>
          <p class="muted">Affected: {e.affected.filter((a: any) => a.package.name === p.name && a.package.ecosystem === p.ecosystem).map(versionText).join('; ')}</p>
        </div>
      </li>
    ))}
  </ol>

  {badge && (
    <>
      <h2>README badge</h2>
      <p class="muted column">Shows the current status of the latest release.</p>
      <CodeBlock code={badge} />
    </>
  )}
</Base>

<style>
  .vbody h1 code { font-family: var(--mono); font-size: clamp(1.6rem, 1rem + 3vw, 3rem); letter-spacing: -0.01em; font-weight: 700; overflow-wrap: anywhere; text-transform: none; }
  .lede { margin: 1.1rem 0 0; font-size: 1.15rem; }
  .imitates { margin: 0.9rem 0 0; color: var(--malicious); font-weight: 700; }
  .rows { list-style: none; padding: 0; margin: 0; border-top: 1px solid var(--rule-strong); }
  .row { display: grid; grid-template-columns: 9.5rem 1fr; gap: 1.25rem; padding: 1rem 0; border-bottom: 1px solid var(--rule); }
  .tab { text-decoration: none; justify-self: start; align-self: start; }
  .body { display: grid; gap: 0.3rem; min-width: 0; }
  .body h3 { font: 700 1.3rem/1.25 var(--sans); margin: 0; max-width: 62ch; }
  .body h3 a { color: var(--ink); text-decoration: none; }
  .body h3 a:hover { text-decoration: underline; text-decoration-thickness: 3px; }
  .body p { margin: 0; }
  .meta { font-size: 0.82rem; }
  .meta a { color: var(--ink-2); text-decoration: none; }
  @media (max-width: 560px) { .row { grid-template-columns: 1fr; gap: 0.4rem; } }
</style>
