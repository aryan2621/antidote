---
// A copyable snippet. The copy button is added by script, so the text stays usable without JS.
interface Props { code: string; label?: string }
const { code, label } = Astro.props;
---
<figure class="code">
  {label && <figcaption class="sc">{label}</figcaption>}
  <div class="box">
    <pre><code>{code}</code></pre>
    <button type="button" class="copy" data-copy={code} aria-label={label ? `Copy ${label}` : 'Copy snippet'} hidden>Copy</button>
  </div>
</figure>

<style>
  .code { margin: 0 0 1.25rem; }
  figcaption { font-size: 1.05rem; color: var(--ink-2); margin-bottom: 0.4rem; }
  .box { position: relative; background: var(--plate); border: var(--bw) solid var(--ink); border-radius: var(--r); }
  pre { margin: 0; padding: 0.9rem 5.5rem 0.9rem 1rem; overflow-x: auto; font-size: 0.95rem; line-height: 1.55; }
  pre code { font-size: 0.88rem; overflow-wrap: normal; white-space: pre; }
  .copy {
    position: absolute; top: 0.5rem; right: 0.5rem; min-height: 34px; padding: 0 0.8rem;
    font: 800 1rem/1 var(--sc); letter-spacing: 0.1em; text-transform: uppercase; color: var(--paper);
    background: var(--ink); border: 2px solid var(--ink); border-radius: var(--r); cursor: pointer;
  }
  .copy:hover { background: var(--caution); color: #0b0b0c; }
</style>

<script>
  for (const b of document.querySelectorAll<HTMLButtonElement>('button.copy')) {
    b.hidden = !navigator.clipboard;
    b.addEventListener('click', async () => {
      await navigator.clipboard.writeText(b.dataset.copy ?? '');
      b.textContent = 'Copied';
      setTimeout(() => (b.textContent = 'Copy'), 1600);
    });
  }
</script>
