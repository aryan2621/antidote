---
// Horizontal bars drawn as inline SVG at build time. Every bar has its number printed beside it,
// so the chart is a table with shapes, not a picture of one.
interface Props { rows: [string, number][]; color?: string; mono?: boolean; caption: string; max?: number }
const { rows, color = 'var(--moss)', mono = false, caption, max = Math.max(1, ...rows.map((r) => r[1])) } = Astro.props;
---
<figure class="bars">
  <figcaption class="visually-hidden">{caption}</figcaption>
  <ul>
    {rows.map(([k, n]) => (
      <li>
        <span class={`k ${mono ? 'mono' : ''}`}>{k}</span>
        <svg viewBox="0 0 100 10" preserveAspectRatio="none" aria-hidden="true"><rect width="100" height="10" fill="var(--rule)" /><rect width={(100 * n) / max} height="10" fill={color} /></svg>
        <span class="n mono">{n}</span>
      </li>
    ))}
  </ul>
</figure>

<style>
  .bars { margin: 0; }
  ul { list-style: none; padding: 0; margin: 0; display: grid; gap: 0.35rem; max-width: 46rem; }
  li { display: grid; grid-template-columns: minmax(7rem, 11rem) 1fr 3rem; gap: 0.75rem; align-items: center; }
  .k { font-size: 0.98rem; overflow-wrap: anywhere; }
  .k.mono { font-size: 0.8rem; }
  svg { width: 100%; height: 14px; display: block; }
  .n { text-align: right; font-size: 0.85rem; color: var(--ink-2); }
  @media (max-width: 560px) { li { grid-template-columns: 6.5rem 1fr 2.5rem; gap: 0.5rem; } }
</style>
