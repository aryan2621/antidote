---
import '@fontsource/barlow/400.css';
import '@fontsource/barlow/500.css';
import '@fontsource/barlow/700.css';
import '@fontsource/barlow-condensed/600.css';
import '@fontsource/barlow-condensed/700.css';
import '@fontsource/barlow-condensed/800.css';
import '../styles/global.css';
import { href, REPO } from '../lib/entries';

interface Props { title: string; description?: string; current?: string }
const { title, description = 'Open database of malicious and vulnerable AI agent skills, MCP servers and prompts.', current = '' } = Astro.props;
const nav = [
  { key: 'database', label: 'Database', path: '/' },
  { key: 'install', label: 'Install', path: '/install/' },
  { key: 'submit', label: 'Submit', path: '/submit/' },
  { key: 'stats', label: 'Stats', path: '/stats/' },
  { key: 'reporters', label: 'Reporters', path: '/reporters/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#0b0b0c" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="cover">
      <div class="frame bar">
        <a class="brand" href={href('/')} aria-label="Antidote, home">
          <svg viewBox="0 0 64 64" width="32" height="32" aria-hidden="true">
            <circle cx="27" cy="33" r="14" fill="currentColor" />
            <path d="M27 33 46 17h10" fill="none" stroke="var(--caution)" stroke-width="5" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="27" cy="33" r="5" fill="var(--moss)" />
          </svg>
          <span>Antidote</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={href(n.path)} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class="frame">
      <slot />
    </main>
    <footer class="frame foot">
      <p>
        Data is CC-BY-4.0, code is Apache-2.0. Entries describe behavior and indicators from public reports; "reported" entries are not yet independently verified.
      </p>
      <p>
        <a href={`https://github.com/${REPO}`}>Source</a>
        <a href={href('/feed/feed.json')}>Signed feed</a>
        <a href={href('/feed/all.zip')}>OSV bundle</a>
        <a href={`https://github.com/${REPO}/blob/master/GOVERNANCE.md`}>Governance</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: 8px; top: -60px; z-index: 10; background: var(--caution); color: #0b0b0c; padding: 10px 16px; font: 800 1rem/1 var(--sc); letter-spacing: 0.08em; text-transform: uppercase; border: var(--bw) solid #0b0b0c; }
  .skip:focus { top: 8px; }
  .cover { background: var(--moss); color: var(--moss-ink); }
  /* hazard stripe: used only here and on loading states, so it still reads as a warning */
  .cover::after { content: ''; display: block; height: 8px; background: repeating-linear-gradient(135deg, #ffd400 0 10px, #0b0b0c 10px 20px); }
  .cover .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 4px 24px; padding-block: 8px; }
  .cover .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--moss-ink); text-decoration: none; font: 800 1.7rem/1 var(--sc); letter-spacing: 0.12em; text-transform: uppercase; min-height: 48px; }
  .cover nav { display: flex; flex-wrap: wrap; gap: 4px; }
  @media (max-width: 719px) {
    /* all five links stay visible: wrap instead of a hidden scroll */
    .cover nav { flex: 1 1 100%; gap: 2px; padding-bottom: 6px; }
    .cover nav a { padding: 0 10px; }
  }
  .cover nav a { display: inline-flex; align-items: center; min-height: 40px; padding: 0 14px; color: var(--moss-2); text-decoration: none; font: 700 1.1rem/1 var(--sc); letter-spacing: 0.1em; text-transform: uppercase; }
  .cover nav a:hover { color: var(--moss-ink); box-shadow: inset 0 -3px 0 var(--moss-ink); }
  .cover nav a[aria-current='page'] { background: var(--caution); color: #0b0b0c; box-shadow: none; }
  .cover a:focus-visible { outline-color: var(--caution); }
  main { padding-block: 3rem 5rem; min-height: 60vh; }
  .foot { position: relative; padding-block: 1.75rem 3rem; color: var(--ink-2); font-size: 0.95rem; }
  .foot::before { content: ''; position: absolute; top: 0; left: 16px; right: 16px; height: var(--bw); background: var(--ink); }
  @media (min-width: 720px) { .foot::before { left: 32px; right: 32px; } }
  .foot p { margin: 0 0 0.5rem; max-width: var(--measure); }
  .foot a { font-family: var(--mono); font-size: 0.85rem; margin-right: 0.9rem; }
</style>
