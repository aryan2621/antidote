---
import '@fontsource/alegreya-sans/400.css';
import '@fontsource/alegreya-sans/500.css';
import '@fontsource/alegreya-sans/700.css';
import '@fontsource/alegreya-sans/800.css';
import '@fontsource/alegreya-sans-sc/500.css';
import '@fontsource/alegreya-sans-sc/700.css';
import '../styles/global.css';
import { href, REPO } from '../lib/entries';

interface Props { title: string; description?: string; current?: string }
const { title, description = 'Open database of malicious and vulnerable AI agent skills, MCP servers and prompts.', current = '' } = Astro.props;
const nav = [
  { key: 'database', label: 'Database', path: '/' },
  { key: 'install', label: 'Install', path: '/install/' },
  { key: 'submit', label: 'Submit', path: '/submit/' },
  { key: 'stats', label: 'Stats', path: '/stats/' },
  { key: 'reporters', label: 'Reporters', path: '/reporters/' },
];
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="theme-color" content="#1d2b22" />
    <link rel="icon" type="image/svg+xml" href={href('/favicon.svg')} />
  </head>
  <body>
    <a class="skip" href="#main">Skip to content</a>
    <header class="cover">
      <div class="frame bar">
        <a class="brand" href={href('/')} aria-label="Antidote, home">
          <svg viewBox="0 0 64 64" width="30" height="30" aria-hidden="true">
            <circle cx="27" cy="33" r="14" fill="currentColor" />
            <path d="M27 33 46 17h10" fill="none" stroke="var(--moss-2)" stroke-width="4" stroke-linecap="round" stroke-linejoin="round" />
            <circle cx="27" cy="33" r="5" fill="var(--moss)" />
          </svg>
          <span>Antidote</span>
        </a>
        <nav aria-label="Main">
          {nav.map((n) => <a href={href(n.path)} aria-current={current === n.key ? 'page' : undefined}>{n.label}</a>)}
        </nav>
      </div>
    </header>
    <main id="main" class="frame">
      <slot />
    </main>
    <footer class="frame foot">
      <p>
        Data is CC-BY-4.0, code is Apache-2.0. Entries describe behavior and indicators from public reports; "reported" entries are not yet independently verified.
      </p>
      <p>
        <a href={`https://github.com/${REPO}`}>Source</a> ·
        <a href={href('/feed/feed.json')}>Signed feed</a> ·
        <a href={href('/feed/all.zip')}>OSV bundle</a> ·
        <a href={`https://github.com/${REPO}/blob/master/GOVERNANCE.md`}>Governance</a>
      </p>
    </footer>
  </body>
</html>

<style is:global>
  .skip { position: absolute; left: 8px; top: -60px; z-index: 10; background: var(--plate); color: var(--ink); padding: 8px 14px; border: 2px solid var(--focus); border-radius: var(--r); }
  .skip:focus { top: 8px; }
  .cover { background: var(--moss); color: var(--moss-ink); border-bottom: 3px solid var(--fern); }
  .cover .bar { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 6px 24px; padding-block: 10px; }
  .cover .brand { display: inline-flex; align-items: center; gap: 10px; color: var(--moss-ink); text-decoration: none; font: 700 1.5rem/1 var(--sc); letter-spacing: 0.05em; min-height: 44px; }
  .cover nav { display: flex; flex-wrap: wrap; gap: 2px 4px; }
  @media (max-width: 719px) {
    /* Keep nav on one row; lone wrapped items looked broken on phone widths. */
    .cover nav { flex: 1 1 100%; flex-wrap: nowrap; overflow-x: auto; overscroll-behavior-x: contain; scrollbar-width: none; gap: 0; -webkit-overflow-scrolling: touch; }
    .cover nav::-webkit-scrollbar { display: none; }
    .cover nav a { flex: none; padding: 0 10px; font-size: 0.92rem; }
  }
  .cover nav a { display: inline-flex; align-items: center; min-height: 44px; padding: 0 12px; color: var(--moss-2); text-decoration: none; font: 500 1rem/1 var(--sc); letter-spacing: 0.05em; border-bottom: 2px solid transparent; }
  .cover nav a:hover { color: var(--moss-ink); }
  .cover nav a[aria-current='page'] { color: var(--moss-ink); border-bottom-color: var(--moss-ink); }
  .cover a:focus-visible { outline-color: var(--moss-ink); }
  main { padding-block: 2.5rem 4rem; min-height: 60vh; }
  .foot { border-top: 1px solid var(--rule); padding-block: 1.75rem 3rem; color: var(--ink-2); font-size: 0.95rem; }
  .foot p { margin: 0 0 0.5rem; max-width: var(--measure); }
</style>
